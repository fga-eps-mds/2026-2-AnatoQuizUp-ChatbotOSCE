NODE_ENV=development
PORT=3335
LOG_LEVEL=info

# Chave da Gemini API (https://aistudio.google.com/apikey); vazia desliga as rotas de simulacao (503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT - mesmo segredo usado pelo Usuario-Service, propagado pelo BFF
JWT_SECRET_KEY=

# Token interno - mesmo segredo configurado no BFF (INTERNAL_TOKEN); so aceita
# chamadas que passaram pelo proxy do BFF
INTERNAL_TOKEN=

# CORS - origens publicas que podem consumir o ChatbotOSCE
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timeout (ms) para chamadas a Gemini
REQUEST_TIMEOUT_MS=15000

# Limite por IP, por instancia do ChatbotOSCE (janela em ms)
RATE_LIMIT_MAX=1200
RATE_LIMIT_WINDOW_MS=60000

# Manter 0 ate confirmar a quantidade de proxies confiaveis da hospedagem
TRUST_PROXY_HOPS=0
